generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContactCategory {
  LEAD
  CLIENT
  PARTNER
  INTERESTING
}

enum ContactSource {
  MANUAL
  LINKEDIN_EXTENSION
  IMPORT
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  STOPPED
  COMPLETED
}

enum FollowUpAction {
  CALL
  EMAIL
  LINKEDIN
  WHATSAPP
  MEETING
}

enum SignalType {
  COMPANY
  CONTACT
  HIRING
  TECHNOLOGY
  GROWTH
  FUNDING
  EXPANSION
  LEADERSHIP
  NEWS
  OTHER
}

enum SignalConfidence {
  LOW
  MEDIUM
  HIGH
}

enum NextBestAction {
  CONTACT
  INVESTIGATE
  CONNECT_LINKEDIN
  SEND_MESSAGE
  SCHEDULE_FOLLOWUP
  WAIT
  DO_NOT_CONTACT
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members      WorkspaceMember[]
  contacts      Contact[]
  pipelineStages PipelineStage[]
  apiTokens     ApiToken[]
  sequences     Sequence[]
  tasks         Task[]
  signals       Signal[]
  contactAudits ContactAudit[]
  contactLists  ContactList[]
}

// One row per Supabase auth user that belongs to a workspace.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @unique // Supabase auth.users.id
  email       String
  role        String    @default("owner")
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#6366f1")
  order       Int
  createdAt   DateTime @default(now())

  contacts Contact[]

  @@index([workspaceId])
  @@unique([workspaceId, order])
}

model Contact {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  category    ContactCategory @default(LEAD)
  source      ContactSource   @default(MANUAL)

  fullName    String
  headline    String?
  company     String?
  title       String?
  location    String?
  email       String?
  phone       String?
  linkedinUrl String?
  avatarUrl   String?
  notes       String?
  tags        String[]        @default([])
  nextFollowUpAt     DateTime?
  nextFollowUpAction FollowUpAction?

  // Soft delete: set instead of a real row delete when a user removes a
  // contact from a list, so it can be restored from the Papelera in
  // Ajustes. Every normal query filters deletedAt: null; a real Prisma
  // delete only happens from the "eliminar definitivamente" action there.
  deletedAt DateTime?

  // Demand Signal Scoring — each dimension is 0-5, entered manually for now.
  // The total (max 20) is intentionally NOT stored: it's always derived from
  // these four fields so it can never drift out of sync with them.
  fitScore           Int             @default(0)
  companySignalScore Int             @default(0)
  contactSignalScore Int             @default(0)
  timingScore        Int             @default(0)
  whyNow             String?
  nextBestAction     NextBestAction?

  // Only meaningful while category = LEAD
  pipelineStageId String?
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  stageOrder      Int            @default(0)
  dealValue       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequenceEnrollments SequenceEnrollment[]
  tasks               Task[]
  signals             Signal[]
  listMemberships     ContactListMember[]

  @@index([workspaceId, category])
  @@index([pipelineStageId])
}

// A static, named group of contacts. Its only job today is letting the
// user select "these N contacts" once and reuse that selection — mainly
// to enroll all of them into a Sequence at once instead of one at a time.
model ContactList {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())

  members ContactListMember[]

  @@index([workspaceId])
}

model ContactListMember {
  id        String      @id @default(cuid())
  listId    String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())

  @@unique([listId, contactId])
  @@index([listId])
  @@index([contactId])
}

// Evidence backing a contact's Demand Signal Score. Entered manually today,
// but deliberately decoupled from the scoring fields on Contact: a future
// integration (Apollo/Apify/AI) can create these same rows without touching
// anything about how the score itself is computed or displayed.
model Signal {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // Reserved for when a standalone Company model exists — company-level
  // signals are attached via `contact` for now since that's the only place
  // they're surfaced.
  companyId   String?

  type        SignalType
  description String
  source      String?
  confidence  SignalConfidence @default(MEDIUM)
  detectedAt  DateTime

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([contactId])
}

// Lightweight forensic trail — right now only wired up for Contact.category
// changes via the normal edit route, after a contact's category changed
// with no code path found to explain it. Not a general activity feed.
model ContactAudit {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String
  field       String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([contactId])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  title       String
  actionType  FollowUpAction?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  // True for the one task auto-generated from a contact's "Próximo
  // seguimiento" date, kept in sync whenever that date changes — as
  // opposed to a task the user added by hand from the Tareas page.
  isFollowUp  Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([workspaceId, completed])
  @@index([contactId])
}

// A sequence is authored here (steps + personalized copy) and tracks who is
// enrolled at which step. Actually *sending* the steps needs a verified
// sending domain the workspace doesn't have yet, so enrollments just record
// intended state for now — there is no scheduler dispatching emails.
model Sequence {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([workspaceId])
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  delayDays  Int      @default(0) // days to wait after the previous step fires
  subject    String
  body       String

  @@index([sequenceId])
  @@unique([sequenceId, order])
}

model SequenceEnrollment {
  id          String           @id @default(cuid())
  sequenceId  String
  sequence    Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  currentStep Int              @default(0)
  enrolledAt  DateTime         @default(now())

  @@unique([sequenceId, contactId])
  @@index([contactId])
}

model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String    @default("Chrome extension")
  tokenHash   String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}
