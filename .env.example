# --- Supabase project settings (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Postgres connection (Project Settings > Database > Connection string) ---
# Pooled connection (use for the app at runtime)
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used only for running migrations)
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- App ---
# Used by the Chrome extension setup instructions and CORS allow-list
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI message composer (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Sequences real send (resend.com) ---
# API key from the Resend dashboard
RESEND_API_KEY=re_...
# Signing secret shown when creating the webhook endpoint in Resend
# (Dashboard > Webhooks > add https://<your-domain>/api/webhooks/resend,
# subscribe to email.bounced and email.complained at least)
RESEND_WEBHOOK_SECRET=whsec_...
# Must be on a domain/subdomain already verified in Resend
SEQUENCES_FROM_EMAIL="Folkleaf <secuencias@mail.witbor.com>"
# Optional — max real sends per click of "Procesar envíos pendientes" (default 30)
SEQUENCES_DAILY_CAP=30
